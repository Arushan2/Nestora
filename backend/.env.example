APP_ENV=local
APP_NAME=Nestora

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nestora
DB_USERNAME=root
DB_PASSWORD=

ADMIN_EMAIL=admin@example.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=Nestora

# Cloudinary settings for business registration document uploads
# Sign up at https://cloudinary.com and set these in your real .env file
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Create an UNSIGNED upload preset in Cloudinary Dashboard:
# Settings > Upload > Upload presets > Create unsigned preset (folder: Home/Nestora)
CLOUDINARY_UPLOAD_PRESET=
# Alternative: target folder for signed uploads (requires API credentials)
CLOUDINARY_UPLOAD_FOLDER=Home/Nestora
